# Copy to /srv/bolt/bolt-worker.env on the server (chmod 600, owner bolt) and fill the values there.
# Never commit the real file. Rotate the Strike key and ADMIN_KEY when moving off Railway (its security incident).
# Optional lines stay commented out: an empty value (NAME=) is read as 0 or "", not as the default.
# Uncomment one only if Railway had it set, with the same value.

# Live $BOLT bot (Strike API wallet of the bot's account)
STRIKE_API_PUBLIC_KEY=
STRIKE_API_PRIVATE_KEY=
# STRIKE_API_BASE=
# LIVE_BUDGET_USD=
# LIVE_MAX_BUDGET_USD=
# LIVE_MAX_COPIES=
# LIVE_MIN_COPY_USD=
# LIVE_DAILY_LOSS_PCT=

# Autopilot (builder program). AUTOPILOT_SECRET must stay EXACTLY the same as on Railway:
# it decrypts users' stored trading keys. A new one means every user reconnects.
STRIKE_BUILDER_CODE=bolt_dev
STRIKE_BUILDER_BASE=https://api.strikefinance.org
AUTOPILOT_SECRET=
# STRIKE_BUILDER_FEE_BPS=
# STRIKE_REFERRAL_CODE=
# AUTOPILOT_PUBLIC=1
# AUTOPILOT_MAX_BUDGET_USD=

# Admin page and the copilot / Autopilot AI
ADMIN_KEY=
# ANTHROPIC_API_KEY=

# Holder demo (Solada coin id)
# SOLADA_ID=
